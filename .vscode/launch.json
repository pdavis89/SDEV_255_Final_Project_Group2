{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "restart": true,
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Client",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173/SDEV_255_Final_Project_Group2/",
      "webRoot": "${workspaceFolder}/client/src",
      "preLaunchTask": "client: dev"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack",
      "configurations": ["Debug Backend", "Debug Client"],
      "stopAll": true
    }
  ]
}
